{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "solution_id",
    "palette_binding",
    "source_image_sha256",
    "plan_sha256",
    "image_sha256",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "solution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "palette_binding": {
      "$ref": "common.schema.json"
    },
    "source_image_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "candidate.schema.json#/$defs/text_record"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
