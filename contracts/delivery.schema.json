{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "palette_binding",
    "outputs",
    "attempts"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "palette_binding": {
      "$ref": "common.schema.json"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "image-output.schema.json"
      },
      "maxItems": 6
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "solution_id",
          "attempt",
          "kind",
          "reason",
          "plan_sha256",
          "source_image_sha256",
          "image_sha256"
        ],
        "properties": {
          "solution_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "kind": {
            "enum": [
              "initial",
              "local_repair",
              "redesign"
            ]
          },
          "reason": {
            "type": "string"
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_image_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "image_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 24
    }
  },
  "additionalProperties": false
}
