{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "solution_id",
    "label",
    "palette_binding",
    "source_image_sha256",
    "plan_sha256",
    "image_path",
    "image_sha256",
    "image_check",
    "design_description_path",
    "design_description_sha256",
    "review_path",
    "attempt"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "solution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "label": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "palette_binding": {
      "$ref": "common.schema.json"
    },
    "source_image_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_path": {
      "type": "string",
      "minLength": 1
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_check": {
      "const": "signature_only_not_full_decode"
    },
    "design_description_path": {
      "type": "string",
      "minLength": 1
    },
    "design_description_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_path": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "typography_path": {
      "type": "string",
      "minLength": 1
    },
    "typography_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
