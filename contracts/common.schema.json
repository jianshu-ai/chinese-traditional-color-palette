{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "palette_id",
    "schema_version",
    "palette_source_sha256",
    "palette_content_sha256",
    "snapshot_path",
    "color_space",
    "canonicalizer_version",
    "run_id"
  ],
  "properties": {
    "palette_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "palette_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "palette_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_path": {
      "const": "inputs/palette.snapshot.json"
    },
    "color_space": {
      "const": "sRGB"
    },
    "canonicalizer_version": {
      "const": "pc-canonical-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
